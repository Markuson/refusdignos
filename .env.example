# Web3Forms Configuration
# Get your free API key at: https://web3forms.com/
PUBLIC_WEB3FORMS_KEY=your_api_key_here

# Cloudinary Configuration (Story 1.3)
# REQUIRED for local dev too, unlike the Keystatic GitHub-App section below --
# `src/lib/cloudinary.ts`'s `buildCloudinaryUrl()` throws at render time for
# every refugio page (homepage, listing, detail) if these two vars aren't set,
# `astro dev` included. Also required for the Cloudinary upload field in the
# Keystatic admin panel (src/components/admin/cloudinary-field.tsx) AND for
# scripts/migrate-refugio-images-to-cloudinary.mjs. Client-visible: read by
# the browser during unsigned upload, so these are `PUBLIC_` vars, not secrets.
#
# 1. Cloudinary Dashboard -> your cloud name is shown at the top.
# 2. Cloudinary Dashboard -> Settings -> Upload -> Upload Presets -> Add
#    Upload Preset, with Signing Mode: Unsigned.
PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here

# Keystatic Admin (/keystatic) Configuration
# Scoped to THIS section only (not the Cloudinary vars above, which local dev
# does need): local dev needs none of this -- `astro dev` always uses
# Keystatic's `local` storage mode (no auth, no GitHub App). Everything below
# is only used in a production build (`astro build`), where Keystatic writes
# content via a GitHub App using the `github` storage mode. Note: `astro
# preview` does NOT work in this project (the @astrojs/vercel adapter doesn't
# support it) -- see docs/KEYSTATIC_GITHUB_APP_SETUP.md for why, and for setup
# steps.
#
# "owner/name" of the repo Keystatic writes to. Public: non-sensitive, read by the
# admin UI in the browser too.
PUBLIC_KEYSTATIC_GITHUB_REPO=Markuson/refusdignos

# The rest are secrets from the GitHub App -- never commit real values.
# See docs/KEYSTATIC_GITHUB_APP_SETUP.md for how to obtain them.
# KEYSTATIC_GITHUB_CLIENT_ID=your_github_app_client_id
# KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_app_client_secret
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=your-github-app-slug
# Any random string of at least 32 characters (used to encrypt the session cookie).
# Generate one with: openssl rand -hex 32
# KEYSTATIC_SECRET=replace_with_a_random_string_of_at_least_32_characters
