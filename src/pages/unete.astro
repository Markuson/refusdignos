---
// Page: Únete (/unete)
// Description: Ways to support the organization - membership and donations

import BaseLayout from '../layouts/BaseLayout.astro';
import BankDetails from '../components/BankDetails.astro';
import { WEB3FORMS_ACCESS_KEY } from '../config/constants';
---

<BaseLayout
  title="Únete - Refugios Libres Dignos"
  description="Apoya nuestra misión de rehabilitar refugios libres. Hazte socio por solo 20€ al año o realiza una donación puntual."
>
  <!-- Hero Section -->
  <section class="bg-background-dark text-forest-green" style="padding-top: 120px; padding-bottom: 80px;">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 fade-in-up">Únete a nosotros</h1>
        <p class="text-xl md:text-2xl fade-in-up">
          Tu apoyo hace posible nuestra misión
        </p>
      </div>
    </div>
  </section>

  <!-- Introduction Section -->
  <section class="py-12 bg-background-light">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <p class="text-lg text-forest-green/90">
          Rehabilitar refugios libres requiere tiempo, esfuerzo y recursos. Cada refugio supone
          una inversión en materiales, además del trabajo voluntario de
          nuestro equipo. Con tu colaboración, podemos seguir devolviendo dignidad a estos
          espacios de montaña.
        </p>
      </div>
    </div>
  </section>

  <!-- Hazte Socio Section -->
  <section class="py-16 bg-background-dark">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-4">
            Hazte Socio
          </h2>
          <p class="text-lg text-forest-green/90 max-w-2xl mx-auto">
            Conviértete en parte activa del proyecto con una cuota anual
          </p>
        </div>

        <!-- Paso 1: Completa el formulario -->
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-full bg-forest-green text-white flex items-center justify-center font-bold text-sm flex-shrink-0">1</div>
          <h3 class="text-xl font-bold text-forest-green">Completa el formulario</h3>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-start mb-12">
          <!-- Benefits Card -->
          <div class="bg-white rounded-lg shadow-md p-6">
            <div class="text-center mb-4">
              <div class="text-2xl md:text-3xl font-bold text-forest-green">Por solo <span class="text-sunrise-orange">20€</span> al año</div>
            </div>

            <ul class="space-y-3 text-forest-green/90">
              <li class="flex items-start gap-2">
                <span class="text-meadow-green mt-1">✓</span>
                <span>Acceso a actividades exclusivas y jornadas de voluntariado</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-meadow-green mt-1">✓</span>
                <span>Sorteos de productos de nuestros colaboradores y descuentos exclusivos</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-meadow-green mt-1">✓</span>
                <span>Acceso a nuestro grupo privado de WhatsApp con información prioritaria sobre proyectos y avances</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-meadow-green mt-1">✓</span>
                <span>La satisfacción de contribuir a cuidar lo que es de todos</span>
              </li>
            </ul>
          </div>

          <!-- Membership Form -->
          <div>
            <!-- Success Message -->
            <div id="membership-success" class="hidden bg-lime-green/10 border-2 border-lime-green text-forest-green p-4 rounded-lg mb-4">
              <div class="flex items-start">
                <svg class="w-6 h-6 text-lime-green mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h3 class="font-bold mb-1">¡Solicitud enviada!</h3>
                  <p class="text-sm">Ahora realiza la transferencia (Paso 2) y te añadiremos al grupo de WhatsApp lo antes posible.</p>
                </div>
              </div>
            </div>

            <!-- Error Message -->
            <div id="membership-error" class="hidden bg-sunrise-orange/10 border-2 border-sunrise-orange text-forest-green p-4 rounded-lg mb-4">
              <div class="flex items-start">
                <svg class="w-6 h-6 text-sunrise-orange mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <div>
                  <h3 class="font-bold mb-1">Error al enviar la solicitud</h3>
                  <p class="text-sm" id="membership-error-text">Hubo un problema. Por favor, inténtalo de nuevo o contáctanos por email.</p>
                </div>
              </div>
            </div>

            <form id="membership-form" class="bg-white rounded-lg shadow-md p-6 space-y-4" method="POST" action="https://api.web3forms.com/submit">
              <!-- Web3Forms Configuration -->
              <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
              <input type="hidden" name="subject" value="Alta de socio" />
              <input type="hidden" name="from_name" value="RefugiosLibresDignos Website" />

              <!-- Nombre completo -->
              <div>
                <label for="nombre" class="block text-sm font-semibold text-forest-green mb-2">
                  Nombre completo <span class="text-sunrise-orange">*</span>
                </label>
                <input
                  type="text"
                  id="nombre"
                  name="nombre"
                  required
                  class="w-full px-4 py-2 border border-off-white rounded focus:outline-none focus:ring-2 focus:ring-sunrise-orange"
                  placeholder="Tu nombre y apellidos"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="membership-email" class="block text-sm font-semibold text-forest-green mb-2">
                  Email <span class="text-sunrise-orange">*</span>
                </label>
                <input
                  type="email"
                  id="membership-email"
                  name="email"
                  required
                  class="w-full px-4 py-2 border border-off-white rounded focus:outline-none focus:ring-2 focus:ring-sunrise-orange"
                  placeholder="tu@email.com"
                />
              </div>

              <!-- Localidad -->
              <div>
                <label for="localidad" class="block text-sm font-semibold text-forest-green mb-2">
                  Localidad <span class="text-sunrise-orange">*</span>
                </label>
                <input
                  type="text"
                  id="localidad"
                  name="localidad"
                  required
                  class="w-full px-4 py-2 border border-off-white rounded focus:outline-none focus:ring-2 focus:ring-sunrise-orange"
                  placeholder="Tu ciudad o pueblo"
                />
              </div>

              <!-- Teléfono -->
              <div>
                <label for="telefono" class="block text-sm font-semibold text-forest-green mb-2">
                  Teléfono <span class="text-sunrise-orange">*</span>
                </label>
                <input
                  type="tel"
                  id="telefono"
                  name="telefono"
                  required
                  class="w-full px-4 py-2 border border-off-white rounded focus:outline-none focus:ring-2 focus:ring-sunrise-orange"
                  placeholder="612 345 678"
                />
                <p class="text-xs text-forest-green/60 mt-1">Para añadirte al grupo de WhatsApp</p>
              </div>

              <!-- Honeypot Field -->
              <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

              <!-- Submit Button -->
              <button type="submit" id="membership-submit-btn" class="btn btn-primary w-full">
                <span id="membership-btn-text">Enviar Solicitud de Alta</span>
                <span id="membership-btn-loading" class="hidden">Enviando...</span>
              </button>

              <p class="text-sm text-forest-green/70">
                * Campos requeridos. Al enviar este formulario aceptas nuestra <a href="/legal/privacidad" class="text-sunrise-orange hover:underline">Política de Privacidad</a>.
              </p>
            </form>
          </div>
        </div>

        <!-- Paso 2: Realiza la transferencia -->
        <div class="flex items-center gap-3 mb-6">
          <div class="w-8 h-8 rounded-full bg-forest-green text-white flex items-center justify-center font-bold text-sm flex-shrink-0">2</div>
          <h3 class="text-xl font-bold text-forest-green">Realiza la transferencia</h3>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-start">
          <BankDetails concepto="Nombre y apellidos" />

          <div class="bg-tan/30 rounded-lg p-4">
            <h4 class="font-semibold text-forest-green mb-2">Instrucciones:</h4>
            <ol class="list-decimal list-inside space-y-2 text-forest-green/90 text-sm">
              <li>Realiza una transferencia de 20€ a la cuenta indicada</li>
              <li>Indica en el concepto <strong>tu nombre y apellidos</strong></li>
              <li>Verificaremos el pago y te añadiremos al grupo de WhatsApp</li>
            </ol>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Patrocinador Section -->
  <section class="py-16 bg-background-light">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-4">
            Conviértete en Patrocinador
          </h2>
          <p class="text-lg text-forest-green/90">
            ¿Tienes una empresa y quieres colaborar con nosotros? Asocia tu marca a un proyecto
            que cuida la montaña y conecta con una comunidad comprometida.
          </p>
        </div>

        <div class="bg-white rounded-lg shadow-md p-6 max-w-2xl mx-auto mb-8">
          <h3 class="text-lg font-semibold text-forest-green mb-4 text-center">¿Qué ofrecemos a nuestros patrocinadores?</h3>
          <ul class="space-y-3 text-forest-green/90">
            <li class="flex items-start gap-2">
              <span class="text-meadow-green mt-1">✓</span>
              <span>Visibilidad en nuestras redes sociales</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-meadow-green mt-1">✓</span>
              <span>Tu logo en nuestra bandera oficial presente en cada refugio</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="text-meadow-green mt-1">✓</span>
              <span>Aparición en cada reel de rehabilitación que publicamos</span>
            </li>
          </ul>
        </div>

        <div class="text-center">
          <a href="/contacto" class="btn btn-primary">
            Contáctanos
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Donación Section -->
  <section class="py-16 bg-background-dark">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-10">
          <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-4">
            Haz una Donación
          </h2>
          <p class="text-lg text-forest-green/90 max-w-2xl mx-auto">
            Si prefieres una aportación puntual, cualquier cantidad ayuda a seguir adelante con el proyecto
          </p>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-stretch">
          <!-- Donation Info -->
          <div class="bg-white rounded-lg shadow-md p-6 flex flex-col">
            <h3 class="text-lg font-semibold text-forest-green mb-4">¿Cómo ayuda tu donación?</h3>
            <ul class="space-y-3 text-forest-green/90 flex-grow">
              <li class="flex items-start gap-2">
                <span class="text-sunrise-orange mt-1">•</span>
                <span>Espacios más acogedores y dignos</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sunrise-orange mt-1">•</span>
                <span>Seguridad para los montañeros (botiquín, extintor)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sunrise-orange mt-1">•</span>
                <span>Luz en emergencias (focos solares)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sunrise-orange mt-1">•</span>
                <span>Momentos de descanso (mobiliario, biblioteca)</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-sunrise-orange mt-1">•</span>
                <span>Mantener vivo el espíritu de montaña</span>
              </li>
            </ul>
            <p class="mt-auto pt-4 text-sm text-forest-green/70">
              Cualquier cantidad, por pequeña que sea, suma y nos ayuda a seguir adelante.
            </p>
          </div>

          <!-- Bank Details for Donations -->
          <div class="flex flex-col">
            <BankDetails concepto="Donación + tu nombre (opcional)" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="py-16 bg-background-light">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl font-bold text-forest-green mb-8 text-center">
          Preguntas Frecuentes
        </h2>

        <div class="space-y-6">
          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="font-semibold text-forest-green mb-2">¿Puedo dejar de ser socio cuando quiera?</h3>
            <p class="text-forest-green/90">
              Sí, puedes cancelar tu cuota en cualquier momento simplemente desactivando la transferencia
              periódica en tu banco.
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="font-semibold text-forest-green mb-2">¿Puedo apadrinar un refugio específico?</h3>
            <p class="text-forest-green/90">
              Sí, puedes destinar tu donación a un refugio concreto. Indícalo en el concepto de la
              transferencia o contáctanos para que te informemos de los proyectos en curso.
            </p>
          </div>

          <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="font-semibold text-forest-green mb-2">¿Puedo colaborar de otra forma?</h3>
            <p class="text-forest-green/90">
              ¡Por supuesto! Ayúdanos a difundir el proyecto en redes sociales o mediante el boca a boca.
              Si quieres donar materiales (madera, pintura, herramientas), ponte en contacto con nosotros.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-tan/30">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-6">
          ¿Tienes dudas?
        </h2>
        <p class="text-lg text-forest-green/90 mb-8">
          Estamos encantados de resolver cualquier pregunta sobre cómo colaborar con nosotros.
        </p>
        <a href="/contacto" class="btn btn-primary">
          Contáctanos
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  function initMembershipForm() {
    const form = document.getElementById('membership-form') as HTMLFormElement;
    const submitBtn = document.getElementById('membership-submit-btn') as HTMLButtonElement;
    const btnText = document.getElementById('membership-btn-text') as HTMLSpanElement;
    const btnLoading = document.getElementById('membership-btn-loading') as HTMLSpanElement;
    const successMessage = document.getElementById('membership-success');
    const errorMessage = document.getElementById('membership-error');
    const errorText = document.getElementById('membership-error-text');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const nombre = formData.get('nombre');
        const email = formData.get('email');
        const localidad = formData.get('localidad');
        const telefono = formData.get('telefono');

        // Hide previous messages
        successMessage?.classList.add('hidden');
        errorMessage?.classList.add('hidden');

        // Basic validation
        if (!nombre || !email || !localidad || !telefono) {
          showError('Por favor, completa todos los campos requeridos.');
          return;
        }

        // Email validation
        const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!emailRegex.test(email as string)) {
          showError('Por favor, introduce un email válido.');
          return;
        }

        // Phone validation
        const phoneClean = (telefono as string).replace(/\s/g, '');
        const phoneRegex = /^[+]?\d{9,15}$/;
        if (!phoneRegex.test(phoneClean)) {
          showError('Por favor, introduce un número de teléfono válido.');
          return;
        }

        // Show loading state
        submitBtn.disabled = true;
        btnText.classList.add('hidden');
        btnLoading?.classList.remove('hidden');

        try {
          const response = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: {
              'Accept': 'application/json'
            }
          });

          if (response.ok) {
            successMessage?.classList.remove('hidden');
            form.reset();
            successMessage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          } else {
            const data = await response.json();
            showError(data.error || 'Hubo un problema al enviar la solicitud.');
          }
        } catch (error) {
          showError('Error de conexión. Por favor, verifica tu conexión a internet.');
        } finally {
          submitBtn.disabled = false;
          btnText.classList.remove('hidden');
          btnLoading?.classList.add('hidden');
        }
      });
    }

    function showError(message: string) {
      if (errorText) errorText.textContent = message;
      errorMessage?.classList.remove('hidden');
      errorMessage?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  // Initialize on page load and after Astro view transitions
  document.addEventListener('astro:page-load', initMembershipForm);
</script>
