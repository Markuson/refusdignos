---
// Page: Colaboradores (/colaboradores)
// Description: Showcase sponsors and encourage new sponsorships

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Get all colaboradores from Content Collections and sort by orden
const colaboradoresRaw = await getCollection('colaboradores');
const colaboradoresSort = colaboradoresRaw.sort(
  (a, b) => (a.data.orden || 999) - (b.data.orden || 999)
);

// Split into Patrocinadores and Colaboradores by the explicit `categoria`
// field (Story 2.1 follow-up) -- previously inferred from a substring match
// on the free-text `tipo` field, which silently misclassified any entry
// whose `tipo` didn't happen to contain "patrocinador"/"sponsor".
const patrocinadores = colaboradoresSort.filter((c) => c.data.categoria === 'patrocinador');
const colaboradores = colaboradoresSort.filter((c) => c.data.categoria === 'colaborador');
---

<BaseLayout
  title="Patrocinadores y Colaboradores - Refugios Libres Dignos"
  description="Conoce a quienes hacen posible que sigamos devolviendo dignidad a los refugios. Nuestros patrocinadores que aportan sustento económico, y colaboradores que aportan materiales."
>
  <!-- Hero Section -->
  <section
    class="bg-background-dark text-forest-green"
    style="padding-top: 120px; padding-bottom: 80px;"
  >
    <div class="container mx-auto px-4 text-center">
      <div class="mx-auto max-w-3xl">
        <h1 class="fade-in-up mb-4 text-4xl font-bold md:text-5xl">
          Patrocinadores y Colaboradores
        </h1>
        <p class="fade-in-up text-xl md:text-2xl">Gracias a quienes hacen posible este proyecto</p>
      </div>
    </div>
  </section>

  <!-- Intro Section -->
  <section class="bg-background-light py-16">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-forest-green/90 mb-8 text-lg">
          Refugios Libres Dignos es una realidad gracias al apoyo esencial de nuestros
          patrocinadores y corporaciones que sostienen el proyecto económicamente, y a los
          excepcionales colaboradores que donan sus productos y materiales. Ambos pilares nos
          permiten seguir rehabilitando y dignificando los refugios libres.
        </p>
      </div>
    </div>
  </section>

  <!-- Patrocinadores Section -->
  <section class="border-tan/20 border-b bg-white py-16">
    <div class="container mx-auto px-4">
      <div class="mb-12 text-center">
        <h2 class="text-forest-green mb-4 text-3xl font-bold">Patrocinadores</h2>
        <p class="text-forest-green/80 mx-auto max-w-2xl text-lg">
          Empresas e instituciones que proporcionan el apoyo económico fundamental para la
          viabilidad de la iniciativa.
        </p>
      </div>

      {
        patrocinadores.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 max-w-4xl mx-auto">
            {patrocinadores.map((patrocinador) => (
              <a
                href={patrocinador.data.url}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-background-light border-tan/30 hover:border-forest-green block transform rounded-lg border p-8 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl"
              >
                <div class="mb-6 text-center">
                  {patrocinador.data.logo ? (
                    <div class="mx-auto mb-4 flex h-32 w-full items-center justify-center">
                      <img
                        src={patrocinador.data.logo}
                        alt={`Logo de ${patrocinador.data.nombre}`}
                        class="max-h-full max-w-full object-contain"
                        style={
                          patrocinador.data.nombre === 'Julián Mairal'
                            ? 'filter: brightness(0) saturate(100%);'
                            : ''
                        }
                      />
                    </div>
                  ) : (
                    <div class="bg-tan/30 mx-auto mb-4 flex h-24 w-24 items-center justify-center rounded">
                      <span class="text-forest-green/50 text-sm">Logo</span>
                    </div>
                  )}
                  <h3 class="text-forest-green mb-2 text-xl font-bold">
                    {patrocinador.data.nombre}
                  </h3>
                  <div class="bg-tan/20 text-forest-green/80 mb-3 inline-block rounded-full px-3 py-1 text-xs font-semibold">
                    Patrocinador
                  </div>
                </div>
                <p class="text-forest-green/80 text-center text-sm">
                  {patrocinador.data.descripcion}
                </p>
              </a>
            ))}
          </div>
        ) : (
          <div class="bg-background-light/50 border-tan/50 mx-auto max-w-4xl rounded-xl border border-dashed p-10 text-center">
            <div class="bg-tan/20 mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full">
              <svg
                class="text-forest-green/60 h-8 w-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                />
              </svg>
            </div>
            <h3 class="text-forest-green mb-2 text-xl font-bold">
              Conviértete en nuestro Patrocinador
            </h3>
            <p class="text-forest-green/80 mx-auto mb-6 max-w-md">
              Sé la primera empresa en apoyar económicamente este proyecto de rehabilitación y
              devuélvele la vida a los refugios libres del Pirineo.
            </p>
            <a href="/contacto" class="btn btn-primary inline-flex">
              Contáctanos para patrocinar
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- Colaboradores (Material Resources) Section -->
  <section class="py-16 bg-background-dark">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-forest-green mb-4">Colaboradores</h2>
        <p class="text-lg text-forest-green/80 max-w-2xl mx-auto">
          Compañías que donan materiales, productos y herramientas que hacen posibles las obras.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {
          colaboradores.map((colaborador) => (
            <a
              href={colaborador.data.url}
              target="_blank"
              rel="noopener noreferrer"
              class="block rounded-lg bg-white p-5 shadow-md transition-all duration-300 hover:scale-105 hover:shadow-xl"
            >
              <div class="mb-4 text-center">
                {colaborador.data.logo ? (
                  <div class="mx-auto mb-3 flex h-20 w-full items-center justify-center px-4">
                    <img
                      src={colaborador.data.logo}
                      alt={`Logo de ${colaborador.data.nombre}`}
                      class="max-h-full max-w-full object-contain"
                      style={
                        colaborador.data.nombre === 'Julián Mairal'
                          ? 'filter: brightness(0) saturate(100%);'
                          : ''
                      }
                    />
                  </div>
                ) : (
                  <div class="bg-tan/30 mx-auto mb-3 flex h-16 w-16 items-center justify-center rounded">
                    <span class="text-forest-green/50 text-[10px]">Logo</span>
                  </div>
                )}
                <h3 class="text-forest-green mb-2 text-sm font-semibold">
                  {colaborador.data.nombre}
                </h3>
                <span class="text-forest-green/60 mb-2 block text-[10px] tracking-widest uppercase">
                  {colaborador.data.tipo}
                </span>
              </div>
              <p class="text-forest-green/70 text-center text-[11px] leading-relaxed">
                {colaborador.data.descripcion}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Support Message Section -->
  <section class="bg-background-light py-16">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-forest-green mb-6 text-3xl font-bold">Gracias por hacer esto posible</h2>
        <p class="text-lg text-forest-green/90 mb-6">
          El respaldo económico de nuestros patrocinadores es el pilar principal que sostiene y da viabilidad a este proyecto de rehabilitación. De igual manera, celebramos el compromiso de cada colaborador que dona materiales y servicios esenciales. Juntos, están logrando que los refugios libres vuelvan a ser espacios dignos y acogedores.
        </p>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-tan/30 py-16">
    <div class="container mx-auto px-4">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="text-forest-green mb-6 text-3xl font-bold md:text-4xl">¿Quieres sumarte?</h2>
        <p class="text-forest-green/90 mb-8 text-lg">
          Hay muchas formas de colaborar: patrocinio económico, donación de materiales, apadrinando
          un refugio, o simplemente difundiendo el proyecto.
        </p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a href="/unete" class="btn btn-secondary"> Hazte Socio </a>
          <a href="/contacto" class="btn btn-primary"> Contáctanos </a>
          <a href="/proyecto" class="btn btn-outline"> Conoce el Proyecto </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
