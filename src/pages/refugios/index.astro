---
// Page: Refugios Listing (/refugios)
// Description: Display all refuge rehabilitation projects

import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildCloudinaryUrl, buildCloudinarySrcSet } from '../../lib/cloudinary';

// Same widths/sizes the old `astro:assets <Image widths={[400, 600]}
// sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw">` call
// used for this card thumbnail, before Story 1.3 swapped to Cloudinary URLs.
const CARD_WIDTHS = [400, 600];
const CARD_SIZES = '(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw';

// Get all refugios from Content Collections. `imagenes` is `.min(1)` in the
// Zod schema, so this should never happen in practice -- but the schema only
// enforces content committed through the normal flow, and indexing
// `imagenes[0]` unguarded would crash the build on any refugio that somehow
// has an empty array. Mirrors the `refugiosWithImages` filter already used
// on the homepage (src/pages/index.astro).
const allRefugios = await getCollection('refugios');
const refugios = allRefugios.filter((refugio) => refugio.data.imagenes.length > 0);
---

<BaseLayout
  title="Nuestros Refugios - RefugiosLibresDignos"
  description="Descubre los refugios libres que estamos rehabilitando para crear espacios seguros y dignos."
>
  <!-- Hero Section -->
  <section class="bg-background-dark text-forest-green" style="padding-top: 120px; padding-bottom: 80px;">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 fade-in-up">Nuestros Refugios</h1>
        <p class="text-xl md:text-2xl fade-in-up">
          Proyectos de rehabilitación de refugios libres
        </p>
      </div>
    </div>
  </section>

  <!-- Refuges Grid -->
  <section class="py-16 bg-background-light">
    <div class="container mx-auto px-4">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {
          refugios.map((refugio) => (
            <a href={`/refugios/${refugio.slug}`} class="block">
              <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 hover:scale-105 cursor-pointer h-full">
                {/* Refugio Image */}
                <div class="h-48 overflow-hidden">
                  <img
                    src={buildCloudinaryUrl(refugio.data.imagenes[0].publicId, 'w_600,f_auto,q_auto')}
                    srcset={buildCloudinarySrcSet(refugio.data.imagenes[0].publicId, CARD_WIDTHS)}
                    sizes={CARD_SIZES}
                    width="600"
                    height="338"
                    alt={refugio.data.imagenes[0].alt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    transition:name={`refugio-image-${refugio.slug}`}
                  />
                </div>

                {/* Card Content */}
                <div class="p-6">
                  <h2 class="text-2xl font-semibold text-forest-green mb-3" transition:name={`refugio-title-${refugio.slug}`}>{refugio.data.title}</h2>

                  <p class="text-sm text-lime-green mb-2">📍 {refugio.data.ubicacion}</p>

                  <div class="flex gap-4 text-xs text-forest-green/70 mb-3">
                    {refugio.data.altitud && refugio.data.altitud !== 'COMPLETAR' && (
                      <span>⛰️ {refugio.data.altitud}</span>
                    )}
                    {refugio.data.capacidad && refugio.data.capacidad !== 'COMPLETAR' && (
                      <span>👥 {refugio.data.capacidad}</span>
                    )}
                  </div>

                  <p class="text-forest-green/80 mb-4 line-clamp-3">{refugio.data.descripcionCorta}</p>
                </div>
              </article>
            </a>
          ))
        }
      </div>

      {/* Empty State (if no refugios) */}
      {
        refugios.length === 0 && (
          <div class="text-center py-16">
            <p class="text-xl text-forest-green/70">
              Pronto tendremos refugios aquí. ¡Estamos trabajando en ello!
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- Info Section -->
  <section class="py-16 bg-tan/30">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl font-bold text-forest-green mb-6">
          Cada Refugio, Una Historia
        </h2>
        <p class="text-lg text-forest-green/90 mb-8">
          Cada refugio que rehabilitamos es "brindado" a un colectivo específico. No son
          simplemente espacios vacíos, sino hogares temporales para los escursionistas.
        </p>
        <a href="/proyecto" class="btn btn-primary">
          Conoce Nuestro Proyecto
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
