---
// Page: Proyecto (/proyecto)
// Description: Organization mission, values, and impact

import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import nosotros1 from '../assets/images/nosotros1.webp';
import nosotros2 from '../assets/images/nosotros2.webp';
import proyectoPage from '../content/proyecto-page/index.json';
---

<BaseLayout
  title="Nuestro Proyecto - Refugios Libres Dignos"
  description="Siete amigos zaragozanos que rehabilitamos refugios libres. De una cuadra a un hotel: devolviendo dignidad a los espacios de montaña."
>
  <!-- Hero Section -->
  <section class="bg-background-dark text-forest-green" style="padding-top: 120px; padding-bottom: 80px;">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 fade-in-up">{proyectoPage.heroTitle}</h1>
        <p class="text-xl md:text-2xl fade-in-up">
          {proyectoPage.heroSubtitle}
        </p>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="py-16 bg-background-light">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-6 text-center">
          {proyectoPage.historiaTitle}
        </h2>
        <div class="prose prose-lg">
          <p class="text-lg text-forest-green/90 mb-4">
            {proyectoPage.historiaParagraph1}
          </p>
          <div class="my-8 rounded-lg overflow-hidden max-w-2xl mx-auto">
            <Image
              src={nosotros2}
              alt="Trabajo en los refugios"
              class="w-full h-auto"
              widths={[400, 600]}
              sizes="(max-width: 768px) 100vw, 600px"
              loading="lazy"
            />
          </div>
          <p class="text-lg text-forest-green/90 mb-4">
            {proyectoPage.historiaParagraph2}
          </p>
          <p class="text-lg text-forest-green/90 mb-4">
            {proyectoPage.historiaParagraph3}
          </p>
          <div class="my-8 rounded-lg overflow-hidden max-w-md mx-auto">
            <Image
              src={nosotros1}
              alt="Equipo de Refugios Libres Dignos"
              class="w-full h-auto"
              widths={[300, 400]}
              sizes="(max-width: 768px) 100vw, 400px"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Values Section -->
  <section class="py-16 bg-background-dark">
    <div class="container mx-auto px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-12 text-center">
        Nuestros Valores
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {proyectoPage.valores.map((valor) => (
          <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="text-4xl mb-4">{valor.icono}</div>
            <h3 class="text-xl font-semibold text-forest-green mb-3">
              {valor.titulo}
            </h3>
            <p class="text-forest-green/80">
              {valor.descripcion}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Impact Section -->
  <section class="py-16 bg-background-light">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-8">
          {proyectoPage.impactoTitle}
        </h2>
        <div class="max-w-3xl mx-auto text-left mb-12">
          <ul class="space-y-3 text-lg text-forest-green/90">
            {proyectoPage.impactoChecklist.map((item) => (
              <li>✓ {item}</li>
            ))}
          </ul>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          {proyectoPage.impactoStats.map((stat) => (
            <div>
              <div class="text-5xl font-bold text-sunrise-orange mb-2">{stat.numero}</div>
              <p class="text-lg text-forest-green">{stat.etiqueta}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-16 bg-tan/30">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-forest-green mb-6">
          {proyectoPage.ctaTitle}
        </h2>
        <p class="text-lg text-forest-green/90 mb-8">
          {proyectoPage.ctaText}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/unete" class="btn btn-secondary">
            Hazte Socio
          </a>
          <a href="/colaboradores" class="btn btn-primary">
            Conoce a Nuestros Colaboradores
          </a>
          <a href="/contacto" class="btn btn-outline">
            Contáctanos
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
